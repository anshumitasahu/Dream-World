// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String  @id @default(cuid())
  email     String  @unique
  name      String?
  password  String?
  googleId  String? @unique
  avatarUrl String?

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  userLikes UserLikes[]
  userChats UserChat[]
  dreams    Dream[]
}

model UserChat {
  id     String @id @default(cuid())
  title  String
  userId String

  user User @relation(fields: [userId], references: [id])

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  userChatHistories UserChatHistory[]
  dream             Dream?
}

model UserChatHistory {
  id         String @id @default(cuid())
  userChatId String
  message    String
  response   Json

  userChat UserChat @relation(fields: [userChatId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Dream {
  id          String @id @default(cuid())
  userChatId  String @unique
  title       String
  prompt      String
  likes       Int    @default(0)
  authorId    String

  userChat UserChat @relation(fields: [userChatId], references: [id])
  author   User     @relation(fields: [authorId], references: [id])

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  userLikes UserLikes[]
  dreamTags DreamTags[]
}

model Tags {
  id   String @id @default(cuid())
  name String @unique

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  dreamTags DreamTags[]
}

model DreamTags {
  id      String @id @default(cuid())
  dreamId String
  tagId   String

  dream Dream @relation(fields: [dreamId], references: [id])
  tag   Tags  @relation(fields: [tagId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserLikes {
  id      String @id @default(cuid())
  userId  String
  dreamId String

  user  User  @relation(fields: [userId], references: [id])
  dream Dream @relation(fields: [dreamId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
