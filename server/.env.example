# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/mydb?schema=public"

# Secret used to sign JWTs (generate with: openssl rand -hex 32)
JWT_SECRET=""

# Google OAuth 2.0 Client ID (Google Cloud Console -> Credentials -> OAuth client ID, type: Web application)
GOOGLE_CLIENT_ID=""

# OpenRouter API key used by the world-builder agent
OPENROUTER_API_KEY=""

# Optional: override the OpenRouter model (defaults to openrouter/free)
OPENROUTER_MODEL=""
